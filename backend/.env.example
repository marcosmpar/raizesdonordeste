# Perfil: dev (H2, padrão) ou prod (PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# Obrigatórias no perfil prod
DB_URL=jdbc:postgresql://localhost:5432/raizesdonordeste
DB_USER=raizes
DB_PASSWORD=troque-esta-senha

# Chave JWT (mín. 32 caracteres). Obrigatória em prod.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32+chars
JWT_EXPIRATION_SECONDS=3600
