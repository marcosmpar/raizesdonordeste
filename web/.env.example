# Endereço da API Java (usado só pelo servidor do Next.js; nunca vai para o navegador)
BACKEND_URL=http://localhost:8080
# Tempo máximo de espera pela API, em milissegundos (aumente se a API hibernar, ex.: Render free)
BACKEND_TIMEOUT_MS=15000
# Cookie de sessão só em HTTPS. Padrão: true em produção; use false apenas em HTTP local
# COOKIE_SECURE=false
